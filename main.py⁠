from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import os

app = FastAPI(
    title="convenienceIA API",
    description="Super-app de descubrimiento e IA",
    version="1.0.0"
)

class WebhookMessage(BaseModel):
    phone_number: str
    message: str
    business_id: str

@app.get("/")
def read_root():
    return {
        "status": "online",
        "app": "convenienceIA",
        "mensaje": "El motor de la Super-App está funcionando al 100%"
    }

@app.post("/webhook/chat")
async def handle_whatsapp_webhook(data: WebhookMessage):
    try:
        usuario_mensaje = data.message.lower()
        
        if "precio" in usuario_mensaje or "cuanto" in usuario_mensaje:
            respuesta = "¡Hola! Con gusto te compartimos nuestra lista de precios."
        elif "ubicacion" in usuario_mensaje or "donde" in usuario_mensaje:
            respuesta = "Estamos muy cerca de ti, puedes visitarnos cuando gustes."
        else:
            respuesta = "¡Hola! Soy el asistente virtual de convenienceIA, ¿en qué puedo ayudarte hoy?"

        return {
            "status": "success",
            "business_id": data.business_id,
            "reply": respuesta
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

class UserPreference(BaseModel):
    user_id: str
    favorite_food: str
    preferred_drink: str
    age: int

@app.post("/api/user/preferences")
async def save_user_preferences(pref: UserPreference):
    return {
        "status": "saved",
        "message": f"Preferencias guardadas para el usuario {pref.user_id}"
    }
